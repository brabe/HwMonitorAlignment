<Window x:Class="HwMonitorAlignment.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HwMonitorAlignment"
        Width="820" Height="560"
        MinWidth="620" MinHeight="420"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Overview canvas area -->
            <RowDefinition Height="*" MinHeight="160"/>
            <!-- Monitor info boxes -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
             Row 0: Virtual-screen overview
             ============================================================ -->
        <GroupBox Grid.Row="0"
                  Header="Monitor Overview"
                  Margin="0,0,0,8">
            <Border Background="#FF121212" CornerRadius="2">
                <!-- The canvas is sized and populated in code-behind -->
                <Canvas x:Name="OverviewCanvas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ClipToBounds="True"
                        SizeChanged="OverviewCanvas_SizeChanged"/>
            </Border>
        </GroupBox>

        <!-- ============================================================
             Row 1: Per-monitor info boxes
             ============================================================ -->
        <GroupBox Grid.Row="1"
                  Header="Monitor Setup Information"
                  Margin="0,0,0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MonitorInfoPanel"
                              ItemsSource="{Binding Monitors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding DisplayLabel}"
                                      Margin="4,4,4,4"
                                      MinWidth="180">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Device:"
                                               Style="{StaticResource MutedLabelStyle}" Margin="2,2,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding DeviceName}"
                                               Style="{StaticResource LabelStyle}" Margin="2"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Adapter:"
                                               Style="{StaticResource MutedLabelStyle}" Margin="2,2,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding AdapterName}"
                                               Style="{StaticResource LabelStyle}" Margin="2"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Resolution:"
                                               Style="{StaticResource MutedLabelStyle}" Margin="2,2,8,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding ResolutionText}"
                                               Style="{StaticResource LabelStyle}" Margin="2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Position:"
                                               Style="{StaticResource MutedLabelStyle}" Margin="2,2,8,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1"
                                               Text="{Binding PositionText}"
                                               Style="{StaticResource LabelStyle}" Margin="2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Orientation:"
                                               Style="{StaticResource MutedLabelStyle}" Margin="2,2,8,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1"
                                               Text="{Binding OrientationText}"
                                               Style="{StaticResource LabelStyle}" Margin="2"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Primary:"
                                               Style="{StaticResource MutedLabelStyle}" Margin="2,2,8,2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1"
                                               Text="{Binding PrimaryText}"
                                               Style="{StaticResource LabelStyle}" Margin="2"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- ============================================================
             Row 2: Action buttons
             ============================================================ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0">
            <Button x:Name="BtnAbout"
                    Content="About"
                    Style="{StaticResource DarkButtonStyle}"
                    Margin="0,0,8,0"
                    Click="BtnAbout_Click"/>
            <Button x:Name="BtnAdjust"
                    Content="Adjust"
                    Style="{StaticResource AccentButtonStyle}"
                    Margin="0,0,8,0"
                    Click="BtnAdjust_Click"/>
            <Button x:Name="BtnClose"
                    Content="Close"
                    Style="{StaticResource DarkButtonStyle}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
