<Window x:Class="HwMonitorAlignment.Views.AlignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HwMonitorAlignment – Align"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC000000"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        Activated="Window_Activated"
        d:Width="1920" d:Height="1080">

    <!-- Root grid fills the entire window -->
    <Grid x:Name="RootGrid">

        <!-- Alignment lines are drawn on this canvas (code-behind) -->
        <Canvas x:Name="LinesCanvas"
                IsHitTestVisible="False"/>

        <!-- Selection highlight border (visible only when this monitor is selected) -->
        <Border x:Name="SelectionBorder"
                BorderThickness="4"
                Visibility="Collapsed">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FF007ACC"/>
            </Border.BorderBrush>
        </Border>

        <!-- Info box (top-center by default, repositioned in code-behind) -->
        <Border x:Name="InfoBox"
                Background="#DD1E1E1E"
                BorderBrush="#FF007ACC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="TbMonitorLabel"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"/>
                <TextBlock x:Name="TbDeviceName"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FFA0A0A0"
                           TextAlignment="Center"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="TbResolution"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#FFD0D0D0"
                           TextAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="TbPosition"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#FFD0D0D0"
                           TextAlignment="Center"/>
                <TextBlock x:Name="TbPrimary"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FF80C0FF"
                           TextAlignment="Center"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Control box – only shown on the PRIMARY monitor -->
        <Border x:Name="ControlBox"
                Background="#EE1E1E1E"
                BorderBrush="#FF007ACC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,40,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Controls"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,10"
                           TextAlignment="Center"/>

                <!-- Line spacing spinner -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Line spacing: "
                               Grid.Column="0"
                               Foreground="#FFA0A0A0"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TbLineSpacing"
                             Grid.Column="1"
                             Background="#FF2D2D30"
                             Foreground="White"
                             BorderBrush="#FF3F3F46"
                             FontFamily="Segoe UI"
                             FontSize="12"
                             Padding="4,2"
                             Text="100"
                             TextChanged="TbLineSpacing_TextChanged"/>
                </Grid>

                <Separator Background="#FF3F3F46" Margin="0,0,0,10"/>

                <TextBlock Text="Keys:"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FF808080"
                           Margin="0,0,0,4"/>
                <TextBlock Text="↑ ↓  Move ±1 px"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FF909090"/>
                <TextBlock Text="PgUp/PgDn  Move ±10 px"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#FF909090"
                           Margin="0,0,0,10"/>

                <Button x:Name="BtnApply"
                        Content="Apply"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,0,6"
                        Click="BtnApply_Click"/>
                <Button x:Name="BtnReset"
                        Content="Reset"
                        Style="{StaticResource DarkButtonStyle}"
                        Margin="0,0,0,6"
                        Click="BtnReset_Click"/>
                <Button x:Name="BtnClose"
                        Content="Close"
                        Style="{StaticResource DarkButtonStyle}"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
